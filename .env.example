# =================================================================
# CryptoNavigator (cryptotop.chat) — Production Environment Variables
# Copy to .env.local (development) or set as the .env used by the
# Docker `crypto_site` container.
# =================================================================

# Site
NEXT_PUBLIC_SITE_URL="https://cryptotop.chat"

# Database (PostgreSQL / Neon, SSL required)
DATABASE_URL="postgresql://user:password@host:port/database_name?sslmode=require"

# AI & external APIs
ANTHROPIC_API_KEY="your_anthropic_api_key_here"   # AI chat + newsletter digest
COINGECKO_API_KEY="optional_coingecko_api_key"    # optional, higher rate limits

# n8n (trading counter + whale alerts) — app degrades gracefully if unset
N8N_WEBHOOK_BASE="http://n8n_app:5678/webhook"
NEXT_PUBLIC_ROUTER_WEBHOOK="http://localhost:5678/webhook/testgo"

# Email / newsletter (Resend)
RESEND_API_KEY="your_resend_api_key"
CRON_SECRET="your_long_random_string"             # protects /api/cron/*

# Build cache-busting
FORCE_REBUILD="1"

# -----------------------------------------------------------------
# Affiliate (referral) links — canonical 4 exchanges.
# Binance is the spotlight pick. WhiteBIT and MEXC were removed.
# OKX is pending — leave EMPTY and the site falls back to okx.com
# (untracked) until the real referral code arrives.
# -----------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_BINANCE="https://www.binance.com/register?ref=GRO_28502_BIO0R"
NEXT_PUBLIC_AFFILIATE_BYBIT="https://partner.bybit.com/b/160402"
NEXT_PUBLIC_AFFILIATE_OKX=""
NEXT_PUBLIC_AFFILIATE_KUCOIN="https://www.kucoin.com/r/af/CXEEFJ3Y"